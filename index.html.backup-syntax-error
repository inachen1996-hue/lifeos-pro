                                  key={cat.id}
                                  onClick={() => updateHabitCategory(desc, cat.id)}
                                  className={`px-2 py-1 rounded-md text-[10px] font-bold whitespace-nowrap transition-all ${catId === cat.id ? `${cat.color} ${cat.text}` : 'bg-white border border-slate-200 text-slate-400'}`}
                                >
                                  {cat.label}
                                </button>
                              ))}
                              <button onClick={() => deleteHabit(desc)} className="px-2 py-1 rounded-md text-[10px] font-bold bg-red-100 text-red-500 hover:bg-red-200 transition-colors">删除</button>
                            </div>
                          </div>
                        ))
                      )}
                    </div>
                  </div>
                </div>
              )}

              {/* Clear Data Modal */}
              {showClearModal && (
                <div className="fixed inset-0 bg-black/20 backdrop-blur-md z-50 flex items-center justify-center p-4 animate-in">
                  <div className="bg-white w-full max-w-sm p-6 rounded-[2rem] shadow-2xl text-center">
                    <div className="w-16 h-16 bg-red-100 rounded-full flex items-center justify-center mx-auto mb-4">
                      <Trash2 className="w-8 h-8 text-red-500"/>
                    </div>
                    <h3 className="font-bold text-xl mb-2 text-slate-800">确定要清空所有数据？</h3>
                    <p className="text-slate-500 text-sm mb-6 leading-relaxed">
                      这将永久删除所有历史日程、日记、归类习惯和计划。<br/>
                      <span className="text-emerald-500 font-bold">您的 API Key 不会被删除。</span>
                    </p>
                    <div className="flex gap-3">
                      <button onClick={() => setShowClearModal(false)} className="flex-1 py-3 bg-slate-100 rounded-xl font-bold text-slate-600 hover:bg-slate-200">取消</button>
                      <button onClick={handleClearHistory} className="flex-1 py-3 bg-red-500 text-white rounded-xl font-bold hover:bg-red-600 shadow-airy-soft shadow-red-200">确认清空</button>
                    </div>
                  </div>
                </div>
              )}

              {showKeyInput && (
                <div className="fixed inset-0 z-[60] flex items-center justify-center bg-slate-900/20 backdrop-blur-sm p-6 animate-in">
                  <div className="bg-white w-full max-w-md p-8 rounded-[2.5rem] shadow-2xl">
                    <h3 className="font-bold text-xl mb-6">设置 API Key</h3>
                    
                    {/* AI服务提供商选择 */}
                    <div className="mb-6">
                      <label className="text-sm font-bold text-slate-600 mb-2 block">选择 AI 服务</label>
                      <div className="flex gap-2">
                        <button 
                          onClick={() => setApiConfig(prev => ({ ...prev, provider: 'google' }))}
                          className={`flex-1 py-3 rounded-xl font-bold transition-all ${apiConfig.provider === 'google' ? 'bg-macaron-purple text-white' : 'bg-slate-100 text-slate-500'}`}
                        >
                          Google
                        </button>
                        <button 
                          onClick={() => setApiConfig(prev => ({ ...prev, provider: 'openai' }))}
                          className={`flex-1 py-3 rounded-xl font-bold transition-all ${apiConfig.provider === 'openai' ? 'bg-macaron-purple text-white' : 'bg-slate-100 text-slate-500'}`}
                        >
                          OpenAI
                        </button>
                        <button 
                          onClick={() => setApiConfig(prev => ({ ...prev, provider: 'deepseek' }))}
                          className={`flex-1 py-3 rounded-xl font-bold transition-all ${apiConfig.provider === 'deepseek' ? 'bg-macaron-purple text-white' : 'bg-slate-100 text-slate-500'}`}
                        >
                          DeepSeek
                        </button>
                      </div>
                    </div>

                    {/* API Key输入 */}
                    <div className="mb-6">
                      <label className="text-sm font-bold text-slate-600 mb-2 block">
                        {apiConfig.provider === 'google' ? 'Google Gemini API Key' : 
                         apiConfig.provider === 'openai' ? 'OpenAI API Key' : 
                         'DeepSeek API Key'}
                      </label>
                      <input 
                        type="password" 
                        value={apiConfig.keys[apiConfig.provider]} 
                        onChange={(e) => {
                          const newKey = cleanApiKey(e.target.value);
                          setApiConfig(prev => ({
                            ...prev,
                            keys: { ...prev.keys, [prev.provider]: newKey }
                          }));
                        }}
                        className="w-full bg-slate-50 p-5 rounded-2xl text-base outline-none focus:ring-2 ring-airy-purple" 
                        placeholder={
                          apiConfig.provider === 'google' ? '输入 Gemini Key (AIza...)' : 
                          apiConfig.provider === 'openai' ? '输入 OpenAI Key (sk-...)' : 
                          '输入 DeepSeek Key (sk-...)'
                        }
                      />
                      <p className="text-xs text-slate-400 mt-2">
                        {apiConfig.provider === 'google' ? '以 AIza 开头' : '以 sk- 开头'}
                      </p>
                    </div>

                    {/* 测试按钮 */}
                    <button 
                      onClick={async () => {
                        const currentKey = apiConfig.keys[apiConfig.provider];
                        if (!validateApiKey(currentKey, apiConfig.provider)) {
                          showToast('请先输入有效的 API Key', 'error');
                          return;
                        }
                        
                        showToast('正在测试连接...', 'info');
                        
                        try {
                          const testPrompt = '请用JSON格式回复：{"status": "success", "message": "测试成功"}';
                          const result = await callAI(apiConfig.provider, currentKey, testPrompt);
                          console.log('API 测试成功:', result);
                          showToast(`✅ ${apiConfig.provider.toUpperCase()} API 测试成功！`);
                        } catch (error) {
                          console.error('API 测试失败:', error);
                          showToast(`❌ 测试失败: ${error.message}`, 'error');
                        }
                      }}
                      className="w-full py-3 bg-blue-100 text-blue-700 rounded-2xl font-bold mb-4 hover:bg-blue-200 transition-all"
                    >
                      🧪 测试连接
                    </button>

                    {/* 操作按钮 */}
                    <div className="flex gap-3">
                       <button 
                         onClick={() => {
                           setApiConfig(prev => ({
                             ...prev,
                             keys: { ...prev.keys, [prev.provider]: '' }
                           }));
                           showToast('已清除当前 Key');
                         }} 
                         className="flex-1 py-4 bg-slate-100 rounded-2xl font-bold text-slate-500"
                       >
                         清除
                       </button>
                       <button 
                         onClick={() => {
                           const currentKey = apiConfig.keys[apiConfig.provider];
                           if(validateApiKey(currentKey, apiConfig.provider)) {
                             localStorage.setItem('lifeos_pro_api_config', JSON.stringify(apiConfig));
                             setShowKeyInput(false);
                             showToast('Key 已保存');
                           } else {
                             showToast('Key 格式无效', 'error');
                           }
                         }} 
                         className="flex-[2] py-4 bg-slate-800 text-white rounded-2xl font-bold"
                       >
                         保存
                       </button>
                    </div>
                    <button onClick={() => setShowKeyInput(false)} className="w-full mt-6 text-sm text-slate-400 font-bold">关闭</button>
                  </div>
                </div>
              )}
              
              {msg.text && <div className="fixed top-28 left-1/2 -translate-x-1/2 px-8 py-4 rounded-full font-bold shadow-2xl z-[70] bg-slate-800 text-white text-base animate-in flex items-center gap-2">
                  {msg.type === 'error' ? <AlertCircle className="w-5 h-5 text-rose-400"/> : <CheckCircle className="w-5 h-5 text-emerald-400"/>}
                  {msg.text}
              </div>}
            </div>
          );
        }

        // 等待 TimerBackend 加载完成后再启动 React 应用
        function waitForTimerBackend() {
          if (window.TimerBackendReady) {
            return Promise.resolve();
          }
          return new Promise(resolve => {
            console.log('⏳ Waiting for TimerBackend to load...');
            window.addEventListener('timerBackendReady', resolve, { once: true });
          });
        }
        
        function startApp() {
          console.log('🚀 Starting LifeOS...');
          
          waitForTimerBackend().then(() => {
            console.log('📦 TimerBackend available:', !!window.TimerBackend);
            console.log('📦 TimerBackend error:', window.TimerBackendError);
            
            try {
              const rootElement = document.getElementById('root');
              if (!rootElement) {
                throw new Error('Root element not found');
              }
              
              const root = createRoot(rootElement);
              root.render(<ErrorBoundary><App /></ErrorBoundary>);
              console.log('✅ React app rendered successfully');
            } catch (error) {
              console.error('❌ Failed to render React app:', error);
              document.getElementById('root').innerHTML = `
                <div style="display: flex; align-items: center; justify-content: center; min-height: 100vh; background: #FFF9F5; padding: 20px;">
                  <div style="text-align: center; max-width: 500px;">
                    <div style="background: #fee; padding: 20px; border-radius: 20px; margin-bottom: 20px;">
                      <h2 style="color: #c00; margin: 0 0 10px 0;">渲染失败</h2>
                      <p style="color: #666; font-size: 14px;">${error.message}</p>
                    </div>
                    <button onclick="location.reload()" style="background: #5D576B; color: white; padding: 12px 24px; border: none; border-radius: 12px; font-weight: bold; cursor: pointer;">
                      刷新页面
                    </button>
                  </div>
                </div>
              `;
            }
          });
        }
        
        // 启动应用
        startApp();
        
        }); // 闭合 Promise.then
    </script>
</body>
</html>