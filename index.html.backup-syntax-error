    <style>
        /* 空气感马卡龙风格 - Airy Macaron UI */
        body { 
            background: linear-gradient(135deg, #FDFCFB 0%, #F9F7F5 100%); 
            color: #5D576B; 
            -webkit-tap-highlight-color: transparent;
            /* 禁用文本选择和长按菜单 */
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
            -webkit-touch-callout: none;
        }
        
        ::-webkit-scrollbar { width: 0px; background: transparent; }
        
        input, textarea, select { 
            font-size: 16px !important; 
            transition: all 0.3s ease;
        }
        
        /* 空气感滑块 */
        input[type=range] { 
            -webkit-appearance: none; 
            background: transparent; 
        }
        input[type=range]::-webkit-slider-thumb { 
            -webkit-appearance: none; 
            appearance: none;
            height: 20px; 
            width: 20px; 
            border-radius: 50%; 
            background: linear-gradient(135deg, #48CAE4 0%, #A2D2FF 100%);
            margin-top: -8px; 
            box-shadow: 0 4px 12px rgba(72, 202, 228, 0.3);
            transition: all 0.3s ease;
        }
        input[type=range]::-webkit-slider-thumb:hover {
            transform: scale(1.1);
            box-shadow: 0 6px 16px rgba(72, 202, 228, 0.4);
        }
        input[type=range]::-webkit-slider-runnable-track { 
            width: 100%; 
            height: 4px; 
            cursor: pointer; 
            background: linear-gradient(90deg, #E7F5FF 0%, #D0EBFF 100%);
            border-radius: 10px; 
        }
        
        /* 拖动排序样式 - 空气感 */
        .dragging {
            opacity: 0.6;
            transform: scale(1.02);
            box-shadow: 0 12px 32px -4px rgba(72, 202, 228, 0.25);
        }
        .drag-over {
            border-top: 2px solid #48CAE4 !important;
            background: linear-gradient(180deg, #E7F5FF 0%, transparent 100%);
        }
        
        /* 计时器卡片 - 禁用文本选择和长按菜单 */
        .timer-card {
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
            -webkit-touch-callout: none;
            -webkit-tap-highlight-color: transparent;
        }
        
        /* 分类按钮 - 禁用文本选择 */
        .category-button {
            -webkit-user-select: none;
            -moz-user-select: none;
            -ms-user-select: none;
            user-select: none;
            -webkit-touch-callout: none;
            -webkit-tap-highlight-color: transparent;
        }
        
        /* 马卡龙治愈系 - 计时器卡片滑动样式 */
        .timer-card {
            position: relative;
            transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .timer-card.swiped {
            transform: translateX(-80px);
        }
        .timer-delete-action {
            position: absolute;
            right: 0;
            top: 0;
            bottom: 0;
            width: 80px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 20px;
        }
        
        /* 马卡龙治愈系 - 运行中计时器动画（果冻感） */
        @keyframes macaron-pulse {
            0%, 100% { 
                transform: scale(1);
                box-shadow: 0 8px 32px -4px rgba(162, 210, 255, 0.4), 
                            0 4px 16px -2px rgba(162, 210, 255, 0.3),
                            inset 0 2px 8px rgba(255, 255, 255, 0.6);
            }
            50% { 
                transform: scale(1.02);
                box-shadow: 0 12px 40px -4px rgba(162, 210, 255, 0.5), 
                            0 6px 20px -2px rgba(162, 210, 255, 0.4),
                            inset 0 2px 12px rgba(255, 255, 255, 0.8);
            }
        }
        .timer-running {
            animation: macaron-pulse 2s ease-in-out infinite;
            background: linear-gradient(135deg, #E7F5FF 0%, #D0EBFF 100%) !important;
            border: 3px solid #A2D2FF !important;
        }
        
        /* 马卡龙治愈系 - 时间显示动画（柔和跳动） */
        @keyframes time-bounce {
            0%, 100% { 
                transform: scale(1) translateY(0); 
                opacity: 1; 
            }
            50% { 
                transform: scale(1.05) translateY(-2px); 
                opacity: 0.95; 
            }
        }
        .time-display {
            animation: time-bounce 1.8s ease-in-out infinite;
            text-shadow: 0 2px 8px rgba(162, 210, 255, 0.3);
        }
        
        /* 马卡龙治愈系 - 微立体效果 */
        .macaron-card {
            background: linear-gradient(135deg, #FFFFFF 0%, #F9F7F5 100%);
            box-shadow: 0 8px 24px -4px rgba(162, 210, 255, 0.2), 
                        0 4px 12px -2px rgba(162, 210, 255, 0.15),
                        inset 0 1px 4px rgba(255, 255, 255, 0.8);
            border: 2px solid rgba(255, 255, 255, 0.9);
        }
        .macaron-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 40px -4px rgba(162, 210, 255, 0.3), 
                        0 8px 20px -2px rgba(162, 210, 255, 0.2),
                        inset 0 2px 8px rgba(255, 255, 255, 0.9);
        }
        
        /* 马卡龙治愈系 - 彩色弥散阴影 */
        .macaron-shadow-pink {
            box-shadow: 0 8px 24px -4px rgba(245, 194, 214, 0.3), 
                        0 4px 12px -2px rgba(245, 194, 214, 0.2);
        }
        .macaron-shadow-yellow {
            box-shadow: 0 8px 24px -4px rgba(255, 248, 225, 0.4), 
                        0 4px 12px -2px rgba(255, 235, 153, 0.3);
        }
        .macaron-shadow-green {
            box-shadow: 0 8px 24px -4px rgba(217, 239, 232, 0.4), 
                        0 4px 12px -2px rgba(167, 243, 208, 0.3);
        }
        
        /* 空气感悬停效果 */
        .airy-hover {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .airy-hover:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 32px -4px rgba(72, 202, 228, 0.25);
        }
        
        /* 空气感按钮 */
        .airy-button {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            box-shadow: 0 4px 16px -2px rgba(72, 202, 228, 0.2);
        }
        .airy-button:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 24px -4px rgba(72, 202, 228, 0.3);
        }
        .airy-button:active {
            transform: translateY(0);
            box-shadow: 0 2px 8px -2px rgba(72, 202, 228, 0.2);
        }
        
        /* 弹幕样式 */
        .danmaku-container {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            pointer-events: none;
            z-index: 9999;
            overflow: hidden;
        }
        
        .danmaku-item {
            position: absolute;
            right: -100%;
            white-space: nowrap;
            font-size: 18px;
            font-weight: bold;
            color: #fff;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.3),
                         -1px -1px 2px rgba(0, 0, 0, 0.2);
            padding: 8px 16px;
            border-radius: 20px;
            background: linear-gradient(135deg, 
                rgba(189, 224, 254, 0.9) 0%, 
                rgba(162, 210, 255, 0.9) 50%,
                rgba(200, 162, 224, 0.9) 100%);
            backdrop-filter: blur(8px);
            box-shadow: 0 4px 16px rgba(162, 210, 255, 0.4);
            animation: danmaku-move linear forwards;
        }
        
        @keyframes danmaku-move {
            from {
                right: -100%;
            }
            to {
                right: 100%;
            }
        }
    </style>
</head>
<body>
    <div id="root">
        <!-- 加载指示器 -->
        <div style="display: flex; align-items: center; justify-content: center; min-height: 100vh; background: #FFF9F5;">
            <div style="text-align: center;">
                <div style="width: 60px; height: 60px; border: 4px solid #E2C2FF; border-top-color: #5D576B; border-radius: 50%; animation: spin 1s linear infinite; margin: 0 auto 20px;"></div>
                <p style="color: #5D576B; font-weight: bold;">加载中...</p>
            </div>
        </div>
        <style>
            @keyframes spin {
                to { transform: rotate(360deg); }
            }
        </style>
    </div>

    <!-- Timer Backend Modules -->
    <script type="module">
      (async function() {
        try {
          console.log('🔄 Loading Timer Backend modules...');
          
          // 导入后端模块并暴露到全局
          const { TimerStorage, CategoryStorage, EventStorage } = await import('./dist/storage.js');
          const { TimerManager } = await import('./dist/timer-manager.js');
          const { CategoryManager } = await import('./dist/category-manager.js');
          const { StopwatchEngine } = await import('./dist/stopwatch-engine.js');
          const { CountdownEngine } = await import('./dist/countdown-engine.js');
          const { PomodoroEngine } = await import('./dist/pomodoro-engine.js');
          const { EventManager } = await import('./dist/event-manager.js');
          const { ConflictResolver } = await import('./dist/conflict-resolver.js');
          const { BlankPeriodDetector } = await import('./dist/blank-period-detector.js');
          const { alarmService } = await import('./dist/alarm-service.js');
          const { DEFAULT_CATEGORIES } = await import('./dist/types.js');

          // 暴露到全局供 React 使用
          window.TimerBackend = {
            TimerStorage,
            CategoryStorage,
            EventStorage,
            TimerManager,
            CategoryManager,
            StopwatchEngine,
            CountdownEngine,
            PomodoroEngine,
            EventManager,
            ConflictResolver,
            BlankPeriodDetector,
            alarmService,
            DEFAULT_CATEGORIES
          };
          
          console.log('✅ Timer Backend loaded successfully');
          
          // 设置加载完成标记
          window.TimerBackendReady = true;
          window.dispatchEvent(new Event('timerBackendReady'));
          
        } catch (error) {
          console.error('❌ Failed to load Timer Backend:', error);
          // 设置一个标记，让React知道模块加载失败
          window.TimerBackendError = error.message;
          window.TimerBackendReady = false;
          window.dispatchEvent(new Event('timerBackendReady'));
        }
      })();
    </script>

    <!-- Load dependencies as ES modules -->
    <script type="module">
        // Load and expose dependencies to global scope
        (async function() {
            try {
                console.log('🔄 Loading dependencies...');
                
                // Load Lucide icons
                const lucide = await import('https://esm.sh/lucide-react@0.294.0?deps=react@18.2.0');
                window.LucideIcons = lucide;
                console.log('✓ Lucide icons loaded');
                
                // Load Google AI
                const googleAI = await import('https://esm.run/@google/generative-ai');
                window.GoogleGenerativeAI = googleAI.GoogleGenerativeAI;
                console.log('✓ Google AI loaded');
                
                console.log('✅ All dependencies loaded');
                window.DependenciesReady = true;
                window.dispatchEvent(new Event('dependenciesReady'));
            } catch (error) {
                console.error('❌ Failed to load dependencies:', error);
                window.DependenciesError = error.message;
                window.DependenciesReady = false;
                window.dispatchEvent(new Event('dependenciesReady'));
            }
        })();
    </script>

    <script type="text/babel">
        console.log('🚀 Babel script starting...');
        
        // Wait for dependencies using Promise chain instead of async/await
        function waitForDependencies() {
            if (window.DependenciesReady) {
                return Promise.resolve();
            }
            return new Promise(resolve => {
                console.log('⏳ Waiting for dependencies...');
                window.addEventListener('dependenciesReady', resolve, { once: true });
            });
        }
        
        waitForDependencies().then(() => {
            if (window.DependenciesError) {
                console.error('❌ Dependencies failed to load:', window.DependenciesError);
                document.getElementById('root').innerHTML = `
                    <div style="padding: 40px; text-align: center;">
                        <h2 style="color: #f44336;">依赖加载失败</h2>
                        <p>${window.DependenciesError}</p>
                        <button onclick="location.reload()" style="padding: 10px 20px; margin-top: 20px;">刷新页面</button>
                    </div>
                `;
                return;
            }
            
            console.log('✓ Dependencies ready');
            
            // Use React from global scope (UMD)
            const { useState, useEffect, useRef, useMemo, useCallback } = React;
            const { createRoot } = ReactDOM;
            
            // Destructure Lucide icons
            const {
                Play, Calendar, Activity, BrainCircuit, AlertCircle, Moon, Briefcase, BookOpen, Gamepad2, Coffee, 
                Heart, Sunrise, Snowflake, Plus, X, Timer, List, Sparkles, ShieldCheck, Loader2, Link2, CheckCircle, 
                Settings, ChevronRight, ArrowRight, ChevronDown, ChevronUp, RefreshCw, Clock, PieChart: PieIcon, 
                Save, Trash2, Music, MoveRight, Wand2, Feather, Archive, History, BarChart3, CalendarDays, Battery, 
                BatteryCharging, BatteryFull, BatteryWarning, Lightbulb, Database, Layout, BookMarked, Eraser, Zap, 
                Utensils, TrendingUp, TrendingDown, Minus, ToggleLeft, ToggleRight, Scale, Sofa, Footprints, Droplets, 
                Edit3, Target, ArrowUpRight, ArrowDownRight, PlusCircle, RefreshCcw, Eye, EyeOff, Key, Hourglass, Bath, 
                UtensilsCrossed, FileText, Percent, UserCheck, MessageSquarePlus, Sun, MoonStar, User, ArrowLeftRight, 
                FileJson, RotateCcw, PenTool, Check, CheckSquare, ThermometerSnowflake, Pill, Stethoscope, AlertTriangle, 
                BedDouble, XCircle, TrendingUp: IconTrendingUp, Ban, Book, Pencil, Settings2, Palette, Smile, Frown, Meh, Search, Menu, Bell
            } = window.LucideIcons;

            // 扁平圆润风格计时器图标组件
            const FlatTimerIcon = ({ type, size = 16, className = "" }) => {
              const iconStyle = {
                width: size,
                height: size,
                display: 'inline-block',
                verticalAlign: 'middle'
              };
              
              if (type === 'stopwatch') {
                return (
                  <svg style={iconStyle} className={className} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    {/* 扁平圆润秒表 */}
                    <defs>
                      <linearGradient id="stopwatchGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stopColor="#E3F2FD" />
                        <stop offset="100%" stopColor="#2196F3" />
                      </linearGradient>
                    </defs>
                    {/* 主体圆形 */}
                    <circle cx="12" cy="13" r="8" fill="url(#stopwatchGrad)" stroke="#1976D2" strokeWidth="1"/>
                    {/* 顶部按钮 */}
                    <rect x="11" y="3" width="2" height="3" rx="1" fill="#1976D2"/>
                    {/* 表盘刻度 */}
                    <circle cx="12" cy="13" r="6" fill="none" stroke="white" strokeWidth="0.5" opacity="0.6"/>
                    {/* 指针 */}
                    <line x1="12" y1="13" x2="12" y2="8" stroke="white" strokeWidth="2" strokeLinecap="round"/>
                    <line x1="12" y1="13" x2="15" y2="13" stroke="white" strokeWidth="1.5" strokeLinecap="round"/>
                    {/* 中心点 */}
                    <circle cx="12" cy="13" r="1.5" fill="white"/>
                  </svg>
                );
              }
              
              if (type === 'countdown') {
                return (
                  <svg style={iconStyle} className={className} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    {/* 扁平圆润倒计时 */}
                    <defs>
                      <linearGradient id="countdownGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stopColor="#FFF8E1" />
                        <stop offset="100%" stopColor="#FF9800" />
                      </linearGradient>
                    </defs>
                    {/* 主体圆形 */}
                    <circle cx="12" cy="12" r="9" fill="url(#countdownGrad)" stroke="#F57C00" strokeWidth="1"/>
                    {/* 表盘 */}
                    <circle cx="12" cy="12" r="7" fill="none" stroke="white" strokeWidth="0.5" opacity="0.6"/>
                    {/* 12点刻度 */}
                    <rect x="11.5" y="4" width="1" height="2" rx="0.5" fill="white"/>
                    {/* 3点刻度 */}
                    <rect x="18" y="11.5" width="2" height="1" rx="0.5" fill="white"/>
                    {/* 6点刻度 */}
                    <rect x="11.5" y="18" width="1" height="2" rx="0.5" fill="white"/>
                    {/* 9点刻度 */}
                    <rect x="4" y="11.5" width="2" height="1" rx="0.5" fill="white"/>
                    {/* 指针 */}
                    <line x1="12" y1="12" x2="12" y2="7" stroke="white" strokeWidth="2" strokeLinecap="round"/>
                    <line x1="12" y1="12" x2="16" y2="12" stroke="white" strokeWidth="1.5" strokeLinecap="round"/>
                    {/* 中心点 */}
                    <circle cx="12" cy="12" r="1.5" fill="white"/>
                  </svg>
                );
              }
              
              if (type === 'pomodoro') {
                return (
                  <svg style={iconStyle} className={className} viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    {/* 扁平圆润番茄 */}
                    <defs>
                      <linearGradient id="tomatoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stopColor="#FFEBEE" />
                        <stop offset="100%" stopColor="#E91E63" />
                      </linearGradient>
                      <linearGradient id="leafGrad" x1="0%" y1="0%" x2="100%" y2="100%">
                        <stop offset="0%" stopColor="#C8E6C9" />
                        <stop offset="100%" stopColor="#4CAF50" />
                      </linearGradient>
                    </defs>
                    {/* 番茄主体 */}
                    <ellipse cx="12" cy="14" rx="7" ry="8" fill="url(#tomatoGrad)" stroke="#C2185B" strokeWidth="0.5"/>
                    {/* 番茄顶部凹陷 */}
                    <path d="M8 8 Q12 6 16 8" fill="none" stroke="#C2185B" strokeWidth="1" strokeLinecap="round"/>
                    {/* 叶子 */}
                    <ellipse cx="10" cy="6" rx="2" ry="3" fill="url(#leafGrad)" stroke="#388E3C" strokeWidth="0.5" transform="rotate(-20 10 6)"/>
                    <ellipse cx="14" cy="5" rx="1.5" ry="2.5" fill="url(#leafGrad)" stroke="#388E3C" strokeWidth="0.5" transform="rotate(15 14 5)"/>
                    {/* 高光 */}
                    <ellipse cx="10" cy="11" rx="1.5" ry="2" fill="rgba(255,255,255,0.4)"/>
                  </svg>
                );
              }
              
              // 默认返回秒表图标
