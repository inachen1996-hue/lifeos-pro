                  }
                  
                  // 如果有自定义音效，优先使用
                  if (currentCustomSounds[type]) {
                    console.log('✅ 使用自定义音效:', type);
                    const audio = new Audio(currentCustomSounds[type]);
                    audio.volume = 0.5;
                    audio.play()
                      .then(() => console.log('🔊 音效播放成功'))
                      .catch(err => console.error('❌ 播放音效失败:', err));
                    return;
                  }
                  
                  console.log('⚠️ 未找到自定义音效，使用内置音效');
                  
                  // 否则使用内置音效
                  try {
                    const ctx = new (window.AudioContext || window.webkitAudioContext)();
                    console.log('🎵 AudioContext 状态:', ctx.state);
                    
                    // 如果AudioContext被暂停，尝试恢复
                    if (ctx.state === 'suspended') {
                      console.log('⚠️ AudioContext 被暂停，尝试恢复...');
                      ctx.resume().then(() => {
                        console.log('✅ AudioContext 已恢复');
                        playInternalSound(ctx, type);
                      }).catch(err => {
                        console.error('❌ AudioContext 恢复失败:', err);
                      });
                      return;
                    }
                    
                    playInternalSound(ctx, type);
                  } catch (error) {
                    console.error('❌ AudioContext 创建失败:', error);
                  }
                };
                
                // 内置音效播放函数
                const playInternalSound = (ctx, type) => {
                  console.log(`🎵 开始播放内置音效: ${type}`);
                  const masterGain = ctx.createGain();
                  masterGain.connect(ctx.destination);
                  masterGain.gain.value = 0.5;
                  
                  if (type === 'cheer') {
                    // 喝彩声：激昂的胜利号角 + 人群欢呼
                    const duration = 2.5;
                    
                    // 胜利号角旋律（C大调激昂上行）
                    const melody = [
                      { freq: 523, time: 0, duration: 0.25 },      // C5
                      { freq: 659, time: 0.25, duration: 0.25 },   // E5
                      { freq: 784, time: 0.5, duration: 0.3 },     // G5
                      { freq: 1047, time: 0.8, duration: 0.4 },    // C6 (高潮)
                      { freq: 988, time: 1.2, duration: 0.2 },     // B5
                      { freq: 1047, time: 1.4, duration: 0.6 }     // C6 (结束)
                    ];
                    
                    melody.forEach(({ freq, time, duration: noteDur }) => {
                      // 主音
                      const osc1 = ctx.createOscillator();
                      osc1.frequency.value = freq;
                      osc1.type = 'triangle';
                      
                      // 和声（五度）
                      const osc2 = ctx.createOscillator();
                      osc2.frequency.value = freq * 1.5;
                      osc2.type = 'sine';
                      
                      // 八度
                      const osc3 = ctx.createOscillator();
                      osc3.frequency.value = freq * 2;
                      osc3.type = 'sine';
                      
                      const noteGain = ctx.createGain();
                      const startTime = ctx.currentTime + time;
                      noteGain.gain.setValueAtTime(0, startTime);
                      noteGain.gain.linearRampToValueAtTime(0.3, startTime + 0.02);
                      noteGain.gain.linearRampToValueAtTime(0.25, startTime + noteDur * 0.7);
                      noteGain.gain.exponentialRampToValueAtTime(0.01, startTime + noteDur);
                      
                      osc1.connect(noteGain);
                      osc2.connect(noteGain);
                      osc3.connect(noteGain);
                      noteGain.connect(masterGain);
                      
                      osc1.start(startTime);
                      osc1.stop(startTime + noteDur);
                      osc2.start(startTime);
                      osc2.stop(startTime + noteDur);
                      osc3.start(startTime);
                      osc3.stop(startTime + noteDur);
                    });
                    
                    // 人群欢呼层（从0.5秒开始）
                    const bufferSize = ctx.sampleRate * 2;
                    const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
                    const data = buffer.getChannelData(0);
                    for (let i = 0; i < bufferSize; i++) {
                      data[i] = Math.random() * 2 - 1;
                    }
                    const noise = ctx.createBufferSource();
                    noise.buffer = buffer;
                    
                    const noiseFilter = ctx.createBiquadFilter();
                    noiseFilter.type = 'bandpass';
                    noiseFilter.frequency.value = 2000;
                    noiseFilter.Q.value = 3;
                    
                    const noiseGain = ctx.createGain();
                    noiseGain.gain.setValueAtTime(0, ctx.currentTime + 0.5);
                    noiseGain.gain.linearRampToValueAtTime(0.4, ctx.currentTime + 0.8);
                    noiseGain.gain.linearRampToValueAtTime(0.5, ctx.currentTime + 1.5);
                    noiseGain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + duration);
                    
                    noise.connect(noiseFilter);
                    noiseFilter.connect(noiseGain);
                    noiseGain.connect(masterGain);
                    noise.start(ctx.currentTime + 0.5);
                    noise.stop(ctx.currentTime + duration);
                    
                  } else if (type === 'clap') {
                    // 鼓掌声：热烈的掌声 + 欢呼声
