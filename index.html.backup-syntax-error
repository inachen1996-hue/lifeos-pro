                </div>
              </div>
            </div>
          );
        };

        // --- Data Manager Modal ---
        const DataManagerModal = ({ onClose, historyData, editingDataItem, setEditingDataItem, updateDataItem, deleteDataItem }) => {
          const [searchQuery, setSearchQuery] = useState('');
          const [selectedDate, setSelectedDate] = useState(getTodayDate());
          const [timePeriod, setTimePeriod] = useState(() => {
            const hour = new Date().getHours();
            if (hour >= 0 && hour < 6) return 'dawn';
            if (hour >= 6 && hour < 12) return 'morning';
            if (hour >= 12 && hour < 18) return 'afternoon';
            return 'evening';
          });

          const timePeriods = [
            { value: 'all', label: '全部', hours: [0, 24] },
            { value: 'dawn', label: '凌晨', hours: [0, 6] },
            { value: 'morning', label: '早上', hours: [6, 12] },
            { value: 'afternoon', label: '下午', hours: [12, 18] },
            { value: 'evening', label: '晚上', hours: [18, 24] }
          ];

          // 当开始搜索时，清空日期和时间段筛选
          useEffect(() => {
            if (searchQuery.trim()) {
              setSelectedDate('');
              setTimePeriod('all');
            }
          }, [searchQuery]);

          // 解析时间字符串（HH:MM）
          const parseTime = (timeStr) => {
            if (!timeStr) return null;
            const match = timeStr.match(/(\d{1,2}):(\d{2})/);
            if (!match) return null;
            return parseInt(match[1]);
          };

          // 从完整内容中提取事项名称、时间段和时长
          const parseItemDetails = (fullContent) => {
            // 格式: "日期: 图标 图标 名称 时长 | 开始-结束"
            // 例如: "2024-12-08: ⏱️ ⏱️ 哈哈 2s | 20:10-20:10"
            
            // 提取名称（去掉日期、图标、时长和时间段）
            let name = fullContent;
            name = name.replace(/\d{4}-\d{1,2}-\d{1,2}:\s*/, ''); // 去掉日期
            name = name.replace(/[⏱️⏰🍅💼📚🏃🎯💪🎨🎮☕🌙]/g, ''); // 去掉图标
            name = name.replace(/\s*\d+(\.\d+)?(s|min|h)\s*/g, ''); // 去掉时长
            name = name.replace(/\s*\|\s*\d{1,2}:\d{2}-\d{1,2}:\d{2}\s*$/, ''); // 去掉时间段
            name = name.trim();

            // 提取时间段
            const timeMatch = fullContent.match(/\|\s*(\d{1,2}:\d{2})-(\d{1,2}:\d{2})/);
            const startTime = timeMatch ? timeMatch[1] : '';
            const endTime = timeMatch ? timeMatch[2] : '';
            const timeRange = timeMatch ? `${startTime}-${endTime}` : '';

            // 提取时长
            const durationMatch = fullContent.match(/(\d+(\.\d+)?(s|min|h)(\s+\d+min)?)/);
            const duration = durationMatch ? durationMatch[1] : '';

            return { name, timeRange, duration, startTime };
          };

          // 筛选数据
          const filteredData = useMemo(() => {
            let data = historyData;

            // 1. 按名称搜索（如果有搜索关键词）
            if (searchQuery.trim()) {
              const query = searchQuery.toLowerCase();
              data = data.filter(item => {
                const { name } = parseItemDetails(item.fullContent);
                return name.toLowerCase().includes(query);
              });
            }

            // 2. 按日期筛选（只有在有日期选择时才筛选）
            if (selectedDate) {
              data = data.filter(item => item.date === selectedDate);
            }

            // 3. 按时间段筛选
            if (timePeriod !== 'all') {
              const period = timePeriods.find(p => p.value === timePeriod);
              if (period) {
                data = data.filter(item => {
                  const { startTime } = parseItemDetails(item.fullContent);
                  const hour = parseTime(startTime);
                  if (hour === null) return true;
                  return hour >= period.hours[0] && hour < period.hours[1];
                });
              }
            }

            return data;
          }, [historyData, searchQuery, selectedDate, timePeriod]);

          return (
            <div className="fixed inset-0 bg-black/20 backdrop-blur-md z-[150] flex items-center justify-center p-4 animate-in">
              <div className="bg-white w-full max-w-2xl p-6 rounded-[2rem] shadow-2xl max-h-[85vh] flex flex-col">
                <div className="flex justify-between items-center mb-4">
                  <h3 className="font-bold text-lg">管理数据</h3>
                  <button onClick={() => { onClose(); setEditingDataItem(null); }} className="p-2 bg-slate-100 rounded-full hover:bg-slate-200 transition-colors">
                    <X className="w-4 h-4"/>
                  </button>
                </div>

                {/* 筛选区域 */}
                <div className="space-y-3 mb-4">
                  {/* 搜索框 */}
                  <div className="relative">
                    <input
                      type="text"
                      value={searchQuery}
                      onChange={(e) => setSearchQuery(e.target.value)}
                      placeholder="搜索事项名称..."
                      className="w-full bg-slate-50 pl-10 pr-4 py-2.5 rounded-xl outline-none focus:ring-2 ring-airy-purple text-sm"
                    />
                    <Search className="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2" />
                  </div>

                  {/* 日期选择 */}
                  <div className="relative">
                    <input
                      type="date"
                      value={selectedDate}
                      onChange={(e) => setSelectedDate(e.target.value)}
                      className="w-full bg-slate-50 px-4 py-2.5 rounded-xl outline-none focus:ring-2 ring-airy-purple text-sm font-mono"
                      placeholder="选择日期（可选）"
                    />
                    {selectedDate && (
                      <button
                        onClick={() => setSelectedDate('')}
                        className="absolute right-2 top-1/2 -translate-y-1/2 p-1 bg-slate-200 rounded-full hover:bg-slate-300 transition-colors"
                        title="清空日期"
                      >
                        <X className="w-3 h-3 text-slate-600" />
                      </button>
                    )}
                  </div>

                  {/* 时间段筛选 */}
                  <div className="flex gap-2 overflow-x-auto pb-1">
                    {timePeriods.map(period => (
                      <button
                        key={period.value}
                        onClick={() => setTimePeriod(period.value)}
                        className={`px-4 py-2 rounded-xl text-sm font-bold whitespace-nowrap transition-all ${
                          timePeriod === period.value 
                            ? 'bg-gradient-to-r from-airy-purple to-airy-pink text-white shadow-airy-purple airy-button shadow-md' 
                            : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
                        }`}
                      >
                        {period.label}
                      </button>
                    ))}
                  </div>
                </div>

                {/* 数据列表 */}
                <div className="flex-1 overflow-y-auto space-y-2 pr-1">
                  {filteredData.length === 0 ? (
                    <p className="text-center text-slate-400 mt-10">
                      {searchQuery ? '未找到匹配的数据' : '暂无数据'}
                    </p>
                  ) : (
                    filteredData.map((item) => {
                      const { name, timeRange, duration } = parseItemDetails(item.fullContent);
                      
                      return (
                        <div key={item.id} className="bg-slate-50 p-4 rounded-xl border border-slate-100 hover:border-macaron-blue transition-colors">
                          {editingDataItem?.id === item.id ? (
                            <div className="space-y-3">
                              <div>
                                <label className="text-xs font-bold text-slate-600 mb-1 block">日期</label>
                                <input
                                  type="date"
                                  value={editingDataItem.date}
                                  onChange={(e) => setEditingDataItem({...editingDataItem, date: e.target.value})}
                                  className="w-full bg-white p-2 rounded-lg text-sm outline-none focus:ring-2 ring-airy-purple"
                                />
                              </div>
                              <div>
                                <label className="text-xs font-bold text-slate-600 mb-1 block">事项名称</label>
                                <input
                                  type="text"
                                  value={editingDataItem.description}
                                  onChange={(e) => setEditingDataItem({...editingDataItem, description: e.target.value})}
                                  className="w-full bg-white p-2 rounded-lg text-sm outline-none focus:ring-2 ring-airy-purple"
                                />
                              </div>
                              <div>
                                <label className="text-xs font-bold text-slate-600 mb-1 block">时间段（可选）</label>
                                <div className="flex gap-2 items-center">
                                  <input
                                    type="time"
                                    value={editingDataItem.startTime || ''}
                                    onChange={(e) => setEditingDataItem({...editingDataItem, startTime: e.target.value})}
                                    className="flex-1 bg-white p-2 rounded-lg text-sm outline-none focus:ring-2 ring-airy-purple font-mono"
                                    placeholder="开始"
                                  />
                                  <span className="text-slate-400">-</span>
                                  <input
                                    type="time"
                                    value={editingDataItem.endTime || ''}
                                    onChange={(e) => setEditingDataItem({...editingDataItem, endTime: e.target.value})}
                                    className="flex-1 bg-white p-2 rounded-lg text-sm outline-none focus:ring-2 ring-airy-purple font-mono"
                                    placeholder="结束"
                                  />
                                </div>
                              </div>
                              <div>
                                <label className="text-xs font-bold text-slate-600 mb-1 block">分类</label>
                                <div className="flex gap-2 flex-wrap">
                                  {CATEGORIES.filter(c => c.id !== 'trash').map(cat => (
                                    <button
                                      key={cat.id}
                                      onClick={() => setEditingDataItem({...editingDataItem, category: cat.id})}
                                      className={`px-3 py-1.5 rounded-lg text-xs font-bold transition-all ${editingDataItem.category === cat.id ? `${cat.color} ${cat.text}` : 'bg-white border border-slate-200 text-slate-400'}`}
                                    >
                                      {cat.label}
                                    </button>
                                  ))}
                                </div>
                              </div>
                              <div className="flex gap-2">
                                <button
                                  onClick={() => {
                                    updateDataItem(
                                      item.id, 
                                      editingDataItem.category, 
                                      editingDataItem.description, 
                                      editingDataItem.date,
                                      editingDataItem.startTime,
                                      editingDataItem.endTime
                                    );
                                    setEditingDataItem(null);
                                  }}
                                  className="flex-1 py-2 bg-airy-gray-card text-airy-purple-deep border border-airy-purple-soft shadow-airy-soft airy-button rounded-lg font-bold text-sm"
                                >
                                  保存
                                </button>
                                <button
                                  onClick={() => setEditingDataItem(null)}
                                  className="flex-1 py-2 bg-slate-200 text-slate-600 rounded-lg font-bold text-sm"
                                >
                                  取消
                                </button>
                              </div>
                            </div>
                          ) : (
                            <>
                              <div className="flex justify-between items-start mb-2">
                                <div className="flex items-center gap-2 flex-wrap">
                                  {searchQuery.trim() && (
                                    <span className="text-xs text-slate-400 font-mono">{item.date}</span>
                                  )}
                                  <span className={`text-xs font-bold px-2 py-0.5 rounded ${CATEGORIES.find(c => c.id === item.category)?.color} ${CATEGORIES.find(c => c.id === item.category)?.text}`}>
                                    {CATEGORIES.find(c => c.id === item.category)?.label}
                                  </span>
                                  <span className="text-xs text-slate-500 font-mono">{timeRange}</span>
                                  <span className="text-xs text-slate-400 font-mono">{duration}</span>
                                </div>
                                <div className="flex gap-1">
                                  <button
                                    onClick={() => setEditingDataItem(item)}
                                    className="p-1.5 bg-blue-50 text-blue-600 rounded-lg hover:bg-blue-100 transition-colors"
                                  >
                                    <Edit3 className="w-3 h-3"/>
                                  </button>
                                  <button
                                    onClick={() => deleteDataItem(item.id)}
                                    className="p-1.5 bg-red-50 text-red-500 rounded-lg hover:bg-red-100 transition-colors"
                                  >
                                    <Trash2 className="w-3 h-3"/>
                                  </button>
                                </div>
                              </div>
                              <div className="text-sm font-bold text-slate-700">{name}</div>
                            </>
                          )}
                        </div>
                      );
                    })
                  )}
                </div>
              </div>
            </div>
          );
        };

        // --- UI Components ---
        const AllocationSlider = ({ label, value, onChange, colorBg, barColor, icon: Icon }) => (
          <div className="bg-white/60 backdrop-blur-sm p-4 rounded-2xl border border-white shadow-sm mb-3">
            <div className="flex justify-between items-center mb-3">
              <div className="flex items-center gap-2">
                <div 
                  className="p-2 rounded-xl text-slate-700 shadow-inner"
                  style={{ backgroundColor: barColor }}
                >
                  <Icon className="w-5 h-5" />
                </div>
                <span className="font-bold text-airy-gray-dark text-base">{label}</span>
              </div>
              <div className="text-right bg-white px-3 py-1 rounded-lg border border-slate-100">
                <span className="font-mono font-black text-slate-700 text-lg">{value}h</span>
              </div>
            </div>
            
            {/* 滑块 + 微调按钮 */}
            <div className="flex items-center gap-3">
              {/* 减少按钮 */}
              <button
                onClick={() => onChange(Math.max(0, value - 0.5))}
                className="w-8 h-8 rounded-full border-2 border-slate-300 text-slate-600 hover:border-slate-400 hover:bg-slate-50 transition-all flex items-center justify-center font-bold text-lg flex-shrink-0 disabled:opacity-30 disabled:cursor-not-allowed"
                disabled={value <= 0}
              >
                −
              </button>
              
              {/* 滑块 */}
              <input 
                type="range" 
                min="0" 
                max="12" 
                step="0.5" 
                value={value} 
                onChange={(e) => onChange(Number(e.target.value))} 
                className="flex-1"
              />
              
              {/* 增加按钮 */}
              <button
                onClick={() => onChange(Math.min(12, value + 0.5))}
                className="w-8 h-8 rounded-full border-2 border-slate-300 text-slate-600 hover:border-slate-400 hover:bg-slate-50 transition-all flex items-center justify-center font-bold text-lg flex-shrink-0 disabled:opacity-30 disabled:cursor-not-allowed"
                disabled={value >= 12}
              >
                +
              </button>
            </div>
          </div>
        );
        const MacaronProgressBar = ({ label, target, actual, colorBg, colorBar }) => {
            const maxVal = Math.max(target, actual, 1); const actualPct = (actual / maxVal) * 100; const targetPct = (target / maxVal) * 100;
            return (
                <div className="mb-6">
                    <div className="flex justify-between items-end mb-2 px-1">
                        <span className="text-base font-bold text-slate-600 flex items-center gap-2"><div className={`w-4 h-4 rounded-full ${colorBar}`}></div>{label}</span>
                        <div className="text-right"><div className="text-base font-black text-slate-700">{Number(actual).toFixed(1)}h <span className="text-xs font-normal text-slate-400">/ 目标{target}h</span></div></div>
                    </div>
                    <div className="h-7 w-full bg-slate-100 rounded-2xl relative overflow-hidden shadow-inner">
                        <div className="absolute top-0 bottom-0 border-r-2 border-dashed border-slate-300 z-10" style={{left: `${Math.min(targetPct, 100)}%`}}></div>
                        <div className={`h-full rounded-r-2xl transition-all duration-1000 ${colorBar} opacity-90`} style={{width: `${Math.min(actualPct, 100)}%`}}><div className="w-full h-full opacity-20 bg-[url('data:image/svg+xml;base64,')]"></div></div>
                    </div>
                </div>
            );
        };
        const NavBtn = ({ page, icon: Icon, label, groupColor, activeColor, inactiveColor = 'text-slate-300', activePage, setActivePage, loading, selectedCategory, categories }) => {
            const isActive = activePage === page;
            
            // 获取当前选中分类的颜色方案（用于计时器页面）
            const getCategoryColorScheme = () => {
                if (page !== 'timer' || !isActive) return null;
                
                // 马卡龙色系定义
                const macaronColors = [
                    { bg: 'bg-gradient-to-br from-pink-100 to-pink-200', text: 'text-pink-600', shadow: 'shadow-lg shadow-pink-200/50' }, // 粉色 - 工作
                    { bg: 'bg-gradient-to-br from-yellow-100 to-amber-200', text: 'text-amber-600', shadow: 'shadow-lg shadow-yellow-200/50' }, // 黄色
                    { bg: 'bg-gradient-to-br from-green-100 to-emerald-200', text: 'text-green-600', shadow: 'shadow-lg shadow-green-200/50' }, // 绿色
                    { bg: 'bg-gradient-to-br from-blue-100 to-blue-200', text: 'text-blue-600', shadow: 'shadow-lg shadow-blue-200/50' }, // 蓝色 - 运动
                    { bg: 'bg-gradient-to-br from-purple-100 to-purple-200', text: 'text-purple-600', shadow: 'shadow-lg shadow-purple-200/50' } // 紫色
                ];
                
                if (selectedCategory === 'uncategorized') {
                    return { bg: 'bg-gradient-to-br from-gray-100 to-gray-200', text: 'text-gray-600', shadow: 'shadow-lg shadow-gray-200/50' };
                }
                
                const categoryIndex = categories.findIndex(c => c.id === selectedCategory);
                if (categoryIndex >= 0) {
                    return macaronColors[categoryIndex % macaronColors.length];
                }
                
                return null;
            };
            
            const categoryColorScheme = getCategoryColorScheme();
            
            // 根据页面类型定义图标颜色
            const iconColorMap = {
                'timer': isActive ? (categoryColorScheme ? categoryColorScheme.text : 'text-blue-600') : inactiveColor,
                'diary': isActive ? 'text-green-600' : inactiveColor,
                'review': isActive ? 'text-purple-600' : inactiveColor,
                'plan': isActive ? 'text-yellow-600' : inactiveColor,
                'settings': isActive ? 'text-gray-600' : inactiveColor
            };
            
            // 动态背景颜色（仅计时器页面根据分类变化）
            const dynamicActiveColor = page === 'timer' && isActive && categoryColorScheme 
                ? `${categoryColorScheme.bg} ${categoryColorScheme.shadow}`
                : activeColor;
            
            return (
                <button 
                    onClick={() => setActivePage(page)} 
                    className={`flex-1 py-2 flex flex-col items-center gap-1 transition-all duration-300 ${isActive ? 'scale-105' : 'hover:scale-105'}`}
                >
                    <div className={`p-3 rounded-2xl transition-all ${isActive ? dynamicActiveColor : groupColor}`}>
                        {loading.state && loading.taskType === page ? (
                            <Loader2 className="w-6 h-6 animate-spin text-slate-400"/> 
                        ) : (
                            <Icon className={`w-6 h-6 ${iconColorMap[page]}`}/>
                        )}
                    </div>
                    <span className={`text-xs font-bold transition-colors ${isActive ? iconColorMap[page] : inactiveColor}`}>{label}</span>
                </button>
            );
        };

        // --- Main App ---
        function App() {
          // API配置状态 - 支持多个AI服务提供商
          const [apiConfig, setApiConfig] = useState(() => {
            const saved = localStorage.getItem('lifeos_pro_api_config');
            if (saved) {
              return JSON.parse(saved);
            }
            // 兼容旧版本的单一API key
            const oldKey = localStorage.getItem('lifeos_pro_key');
            return {
              provider: 'google', // 'google', 'openai', 'deepseek'
              keys: {
                google: oldKey || '',
                openai: '',
                deepseek: ''
              }
            };
          });
          const [userApiKey, setUserApiKey] = useState('');
          const [showKeyInput, setShowKeyInput] = useState(false);
          
          // 同步 userApiKey 和 apiConfig
          useEffect(() => {
            const currentKey = apiConfig.keys[apiConfig.provider] || '';
