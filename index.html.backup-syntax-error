                  <div className="absolute inset-0 bg-gradient-to-br from-white/40 to-transparent rounded-[24px]"></div>
                </button>
              </div>
            </div>
          );
        };

        const TimerControlModal = ({ timer, session, onPause, onResume, onStop, onClose }) => {
          const [displayTime, setDisplayTime] = useState('00:00:00');
          const [isRinging, setIsRinging] = useState(false);
          const [oscillator, setOscillator] = useState(null);
          const ringingTimeoutRef = useRef(null);
          const [periodComplete, setPeriodComplete] = useState(false); // 周期完成状态
          const [completedPeriod, setCompletedPeriod] = useState(null); // 完成的周期类型
          const hasRungRef = useRef(false); // 标记是否已经响过铃，防止重复触发

          const formatTime = (seconds) => {
            if (isNaN(seconds) || seconds === null || seconds === undefined) {
              return '00:00:00';
            }
            const h = Math.floor(seconds / 3600);
            const m = Math.floor((seconds % 3600) / 60);
            const s = Math.floor(seconds % 60);
            return `${String(h).padStart(2, '0')}:${String(m).padStart(2, '0')}:${String(s).padStart(2, '0')}`;
          };

          // 播放计时器铃声
          const playAlarm = () => {
            // 如果已经响过铃，不再重复触发
            if (hasRungRef.current) {
              return;
            }
            
            try {
              hasRungRef.current = true; // 标记已经响过铃
              setIsRinging(true);
              
              // 尝试加载自定义计时器铃声（独立于音效按钮）
              const customTimerAlarm = localStorage.getItem('lifeos_pro_timer_alarm');
              if (customTimerAlarm) {
                try {
                  // 使用自定义计时器铃声
                  const audio = new Audio(customTimerAlarm);
                  audio.volume = 0.5;
                  audio.loop = true; // 循环播放
                  
                  audio.onerror = (error) => {
                    console.error('自定义计时器铃声播放失败，使用默认铃声:', error);
                    playDefaultTimerAlarm();
                  };
                  
                  audio.play().then(() => {
                    setOscillator(audio); // 保存 audio 对象以便停止
                    console.log('✅ 使用自定义计时器铃声（循环播放10秒）');
                    
                    // 10秒后自动停止
                    const timeout = setTimeout(() => {
                      audio.pause();
                      audio.currentTime = 0;
                      setIsRinging(false);
                      setOscillator(null);
                    }, 10000);
                    
                    ringingTimeoutRef.current = timeout;
                  }).catch((error) => {
                    console.error('计时器铃声播放失败，使用默认铃声:', error);
                    playDefaultTimerAlarm();
                  });
                  
                  return;
                } catch (e) {
                  console.warn('加载自定义计时器铃声失败，使用默认铃声:', e);
                }
              }
              
              // 如果没有自定义计时器铃声，使用默认铃声
              playDefaultTimerAlarm();
              
            } catch (error) {
              console.error('播放计时器铃声失败:', error);
              setIsRinging(false);
            }
          };
          
          // 播放默认计时器铃声（使用 alarmService 的 Web Audio API）
          const playDefaultTimerAlarm = () => {
            try {
              // 使用 alarmService 的 Web Audio API 功能
              const ctx = new (window.AudioContext || window.webkitAudioContext)();
              const oscillator = ctx.createOscillator();
              const gainNode = ctx.createGain();

              oscillator.connect(gainNode);
              gainNode.connect(ctx.destination);

              oscillator.frequency.value = 800; // 800 Hz beep
              oscillator.type = 'sine';

              const now = ctx.currentTime;
              gainNode.gain.setValueAtTime(0.3, now);
              gainNode.gain.exponentialRampToValueAtTime(0.01, now + 0.5);

              oscillator.start(now);
              oscillator.stop(now + 0.5);

              setOscillator([oscillator]); // 保存振荡器引用
              
              // 0.5秒后清理
              oscillator.onended = () => {
                setIsRinging(false);
                setOscillator(null);
                ctx.close();
              };
              
              console.log('✅ 播放默认计时器铃声（800Hz蜂鸣）');
              
            } catch (error) {
              console.error('播放默认计时器铃声失败:', error);
              setIsRinging(false);
            }
          };
          


          // 停止计时器铃声
          const stopAlarm = () => {
            try {
              // 停止所有类型的音频
              if (oscillator) {
                if (Array.isArray(oscillator)) {
                  // 处理振荡器数组（默认音效）
                  oscillator.forEach(osc => {
                    try {
                      osc.stop();
                      osc.disconnect();
                    } catch (e) {
                      // 忽略已经停止的振荡器
                    }
                  });
                } else if (oscillator instanceof Audio) {
                  // 处理 Audio 对象（自定义音效）
                  try {
                    oscillator.pause();
                    oscillator.currentTime = 0;
                  } catch (e) {
                    // 忽略错误
                  }
                }
              }
              
              // 清除定时器
              if (ringingTimeoutRef.current) {
                clearTimeout(ringingTimeoutRef.current);
                ringingTimeoutRef.current = null;
              }
              
              // 重置状态
              setIsRinging(false);
              setOscillator(null);
            } catch (error) {
              console.error('停止计时器铃声失败:', error);
              // 强制重置状态
              setIsRinging(false);
              setOscillator(null);
            }
          };

          // 清理函数
          useEffect(() => {
            return () => {
              stopAlarm();
            };
          }, []);

          useEffect(() => {
            if (session.status === 'running') {
              const interval = setInterval(() => {
                const now = Date.now();
                const start = new Date(session.startTime).getTime();
                const elapsed = Math.floor((now - start) / 1000);
                
                if (timer.mode === 'stopwatch') {
                  setDisplayTime(formatTime(elapsed));
                } else if (timer.mode === 'countdown') {
                  const duration = timer.settings?.countdownDuration || 25;
                  const remaining = Math.max(0, (duration * 60) - elapsed);
                  setDisplayTime(formatTime(remaining));
                  
                  // 倒计时结束时响铃
                  if (remaining === 0 && !isRinging) {
                    playAlarm();
                  }
                } else if (timer.mode === 'pomodoro') {
                  // 番茄钟：根据当前周期显示倒计时或正计时
                  const workDuration = timer.settings?.workDuration || 25;
                  const restDuration = timer.settings?.restDuration || 5;
                  const currentPeriod = session.currentPeriod || 'work';
                  const duration = currentPeriod === 'work' ? workDuration : restDuration;
                  const remaining = (duration * 60) - elapsed;
                  
                  if (remaining >= 0) {
                    // 倒计时阶段
                    setDisplayTime(formatTime(remaining));
                    
                    // 番茄钟周期结束时响铃并显示确认按钮
                    if (remaining === 0 && !isRinging && !periodComplete) {
                      playAlarm();
                      setPeriodComplete(true);
                      setCompletedPeriod(currentPeriod);
                    }
                  } else {
                    // 延长时间阶段（正计时）
                    const extended = Math.abs(remaining);
                    setDisplayTime('+' + formatTime(extended)); // 显示 +00:05:30 表示延长了5分30秒
                  }
                }
              }, 1000);

              return () => clearInterval(interval);
            }
          }, [session, timer, isRinging, periodComplete]);

          return (
            <div className="fixed inset-0 bg-black/30 backdrop-blur-sm z-[150] flex items-center justify-center p-4 animate-in">
              <div className={`bg-white w-full max-w-sm rounded-[2rem] shadow-2xl text-center transition-all ${isRinging ? 'ring-4 ring-pink-300 ring-offset-4' : ''}`}>
                {/* 头部 */}
                <div className="flex justify-between items-center p-6 pb-4 border-b border-slate-100">
                  <h3 className="font-bold text-lg text-slate-800 flex items-center gap-2">
                    {getFlatIconForMode(timer.mode, 20)} {timer.name}
                  </h3>
                  <button 
                    onClick={() => {
                      stopAlarm(); // 关闭弹窗前先停止响铃
                      onClose();
                    }} 
                    className="p-2 bg-slate-100 rounded-full hover:bg-slate-200 transition-colors"
                  >
                    <X className="w-4 h-4 text-slate-600" />
                  </button>
                </div>

                {/* 内容区 */}
                <div className="p-6 pt-8">

                {/* 响铃提示 */}
                {isRinging && (
                  <div className="mb-4 p-5 bg-gradient-to-br from-pink-50 to-rose-50 border-2 border-pink-200 rounded-2xl shadow-lg shadow-pink-100/50">
                    <div className="flex items-center justify-center gap-2 mb-3">
                      <Music className="w-6 h-6 text-pink-600 animate-pulse" />
                      <span className="font-bold text-pink-600 text-lg">时间到！</span>
                      <Music className="w-6 h-6 text-pink-600 animate-pulse" />
                    </div>
                    <button
                      onClick={() => {
                        stopAlarm();
                        // 如果是番茄钟，停止响铃后显示确认按钮
                        if (timer.mode === 'pomodoro') {
                          setPeriodComplete(true);
                        }
                      }}
                      className="w-full py-3 bg-gradient-to-br from-pink-100 to-rose-200 text-pink-700 rounded-xl font-bold hover:shadow-lg shadow-pink-200/50 transition-all"
                    >
                      停止响铃
                    </button>
                  </div>
                )}

                {/* 番茄钟周期完成确认 */}
                {timer.mode === 'pomodoro' && periodComplete && !isRinging && (
                  <div className="mb-4 p-5 bg-gradient-to-br from-green-50 to-emerald-50 border-2 border-green-200 rounded-2xl shadow-lg shadow-green-100/50">
                    <div className="flex items-center justify-center gap-2 mb-3">
                      <CheckCircle className="w-7 h-7 text-green-600" />
                      <span className="font-bold text-green-600 text-lg">
                        {completedPeriod === 'work' ? '工作时间完成！' : '休息时间完成！'}
                      </span>
                    </div>
                    <p className="text-sm text-green-700 mb-4 font-medium">
                      {completedPeriod === 'work' 
                        ? '选择下一步操作：' 
                        : '选择下一步操作：'}
                    </p>
                    
                    {/* 两个选项按钮 */}
                    <div className="grid grid-cols-2 gap-3">
                      {/* 继续当前状态 */}
                      <button
                        onClick={() => {
                          setPeriodComplete(false);
                          setCompletedPeriod(null);
                          // 继续当前周期，开始正计时延长时间
                          session.status = 'running';
                          onResume(); // 触发继续，会开始正计时
                        }}
                        className="py-4 bg-gradient-to-br from-yellow-100 to-amber-200 text-yellow-700 rounded-xl font-bold hover:shadow-lg shadow-yellow-200/50 transition-all flex flex-col items-center justify-center gap-1"
                      >
                        <Clock className="w-5 h-5" />
                        <span className="text-sm">
                          {completedPeriod === 'work' ? '继续工作' : '继续休息'}
                        </span>
                        <span className="text-xs opacity-70">正计时</span>
                      </button>
                      
                      {/* 切换到下一状态 */}
                      <button
                        onClick={() => {
                          setPeriodComplete(false);
                          setCompletedPeriod(null);
                          hasRungRef.current = false; // 重置铃声标记，允许下个周期播放铃声
                          // 更新session以开始下一个周期
                          if (completedPeriod === 'work') {
                            // 开始休息
                            session.currentPeriod = 'rest';
                            session.startTime = new Date().toISOString();
                          } else {
                            // 开始下一个工作周期
                            session.currentPeriod = 'work';
                            session.currentCycle = (session.currentCycle || 1) + 1;
                            session.startTime = new Date().toISOString();
                          }
                          onResume(); // 触发继续
                        }}
                        className="py-4 bg-gradient-to-br from-green-100 to-emerald-200 text-green-700 rounded-xl font-bold hover:shadow-lg shadow-green-200/50 transition-all flex flex-col items-center justify-center gap-1"
                      >
                        <Play className="w-5 h-5" />
                        <span className="text-sm">
                          {completedPeriod === 'work' ? '开始休息' : '开始工作'}
                        </span>
                        <span className="text-xs opacity-70">
                          {completedPeriod === 'work' 
                            ? `${timer.settings?.restDuration || 5}分钟` 
                            : `${timer.settings?.workDuration || 25}分钟`}
                        </span>
                      </button>
                    </div>
                  </div>
                )}

                {/* 延长时间特殊显示 */}
                {displayTime.startsWith('+') ? (
                  <div className="mb-8">
                    {/* 延长时间背景卡片 */}
                    <div className="bg-gradient-to-br from-amber-50 to-yellow-50 border-2 border-amber-300 rounded-2xl p-6 mb-4">
                      <div className="flex items-center justify-center gap-2 mb-3">
                        <Clock className="w-6 h-6 text-amber-600 animate-pulse" />
                        <span className="text-lg font-bold text-amber-900">延长时间</span>
                      </div>
                      <div className="text-5xl font-black font-mono text-amber-700 text-center">
                        {displayTime}
                      </div>
                    </div>
                    
                    {/* 原始时长信息 */}
                    {timer.mode === 'pomodoro' && (
                      <div className="text-center">
