            lines.forEach(line => {
                if (!line.trim()) return;

                let hours = 0;
                const isoMatch = line.match(isoTimeRegex);
                if (isoMatch) {
                    const start = new Date(isoMatch[1]).getTime();
                    const end = new Date(isoMatch[2]).getTime();
                    if (!isNaN(start) && !isNaN(end) && end > start) hours = (end - start) / (1000 * 60 * 60);
                } else {
