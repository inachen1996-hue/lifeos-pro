                                // 主色调 - 透气蓝色系（用于主要按钮和图标）
                                blue: {
                                    DEFAULT: '#BDE0FE',  // 淡天蓝 - 主按钮
                                    light: '#E7F5FF',    // 极淡蓝 - 卡片背景
                                    soft: '#D0EBFF',     // 柔和蓝 - 悬停状态
                                    deep: '#023E8A',     // 深海蓝 - 文字强调
