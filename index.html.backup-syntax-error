                  className="w-full py-5 bg-gradient-to-br from-[#A2D2FF] to-[#BDE0FE] text-blue-900 rounded-[24px] font-black text-xl transition-all duration-300 hover:scale-[1.02] active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed relative overflow-hidden"
                  style={{
                    boxShadow: '0 12px 32px -4px rgba(162, 210, 255, 0.5), inset 0 2px 12px rgba(255, 255, 255, 0.7)',
