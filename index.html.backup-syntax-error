                    <div className="text-sm text-slate-500">
                      {timer.mode === 'stopwatch' && '正计时模式'}
                      {timer.mode === 'countdown' && `倒计时 ${timer.settings?.countdownDuration || 25} 分钟`}
                      {timer.mode === 'pomodoro' && (
                        <div>
                          <div className="font-bold text-base mb-1 text-slate-800 flex items-center justify-center gap-2">
                            {session.currentPeriod === 'work' ? <><FlatTimerIcon type="pomodoro" size={18} /> 工作时间</> : <>☕ 休息时间</>}
                          </div>
                          <div className="text-sm mb-2 text-slate-600">
                            {session.currentPeriod === 'work' 
                              ? `${timer.settings?.workDuration || 25} 分钟` 
                              : `${timer.settings?.restDuration || 5} 分钟`}
                          </div>
                          <div className="text-xs font-bold text-blue-900 bg-macaron-blue px-3 py-1 rounded-full inline-block">
                            第 {session.currentCycle || 1} / {timer.settings?.cycles || 4} 轮
                          </div>
                        </div>
                      )}
                    </div>
                  </div>
                )}

                {/* 控制按钮 - 周期完成时不显示 */}
                {!(timer.mode === 'pomodoro' && periodComplete) && (
                  <div className="flex gap-3">
                    {session.status === 'running' ? (
                      <button
                        onClick={onPause}
                        className="flex-1 py-4 bg-gradient-to-br from-yellow-100 to-amber-200 text-yellow-700 rounded-xl font-bold flex items-center justify-center gap-2 hover:shadow-lg shadow-yellow-200/50 transition-all"
                      >
                        <Clock className="w-5 h-5" /> 暂停
                      </button>
                    ) : (
                      <button
                        onClick={onResume}
                        className="flex-1 py-4 bg-gradient-to-br from-green-100 to-emerald-200 text-green-700 rounded-xl font-bold flex items-center justify-center gap-2 hover:shadow-lg shadow-green-200/50 transition-all"
                      >
                        <Play className="w-5 h-5" /> 继续
                      </button>
                    )}
                    <button
                      onClick={() => {
                        stopAlarm(); // 先停止响铃
                        onStop(); // 再停止计时器
                      }}
                      className="flex-1 py-4 bg-gradient-to-br from-pink-100 to-rose-200 text-pink-700 rounded-xl font-bold flex items-center justify-center gap-2 hover:shadow-lg shadow-pink-200/50 transition-all"
                    >
                      <X className="w-5 h-5" /> 停止
                    </button>
