                    clapPattern.forEach((time, idx) => {
                      // 多层次鼓掌声
                      for (let layer = 0; layer < 3; layer++) {
                        const bufferSize = ctx.sampleRate * 0.04;
                        const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
                        const data = buffer.getChannelData(0);
                        
                        for (let i = 0; i < bufferSize; i++) {
                          const envelope = Math.exp(-i / (bufferSize * 0.08));
                          data[i] = (Math.random() * 2 - 1) * envelope;
                        }
                        
                        const clap = ctx.createBufferSource();
                        clap.buffer = buffer;
                        
                        const clapFilter = ctx.createBiquadFilter();
                        clapFilter.type = 'bandpass';
                        clapFilter.frequency.value = 1000 + layer * 500;
                        clapFilter.Q.value = 2;
                        
                        const clapGain = ctx.createGain();
                        const intensity = Math.min(1, idx / 10); // 逐渐增强
                        clapGain.gain.value = (0.3 + Math.random() * 0.2) * intensity;
                        
                        clap.connect(clapFilter);
                        clapFilter.connect(clapGain);
                        clapGain.connect(masterGain);
                        
                        clap.start(ctx.currentTime + time + layer * 0.005);
                      }
                    });
                    
                    // 欢呼声背景
                    const bufferSize = ctx.sampleRate * duration;
                    const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
                    const data = buffer.getChannelData(0);
                    for (let i = 0; i < bufferSize; i++) {
                      data[i] = Math.random() * 2 - 1;
                    }
                    const cheer = ctx.createBufferSource();
                    cheer.buffer = buffer;
                    
                    const cheerFilter = ctx.createBiquadFilter();
                    cheerFilter.type = 'bandpass';
                    cheerFilter.frequency.value = 1800;
                    cheerFilter.Q.value = 2;
                    
                    const cheerGain = ctx.createGain();
                    cheerGain.gain.setValueAtTime(0, ctx.currentTime);
                    cheerGain.gain.linearRampToValueAtTime(0.25, ctx.currentTime + 0.5);
                    cheerGain.gain.linearRampToValueAtTime(0.3, ctx.currentTime + 1.5);
                    cheerGain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + duration);
                    
                    cheer.connect(cheerFilter);
                    cheerFilter.connect(cheerGain);
                    cheerGain.connect(masterGain);
                    cheer.start(ctx.currentTime);
                    cheer.stop(ctx.currentTime + duration);
                    
                  } else if (type === 'drum') {
                    // 打鼓声：震撼的战鼓 + 锣鼓喧天
                    const duration = 2.5;
                    
                    // 战鼓节奏（渐强）
                    const drumPattern = [
                      { time: 0, freq: 60, intensity: 0.7, decay: 0.4 },
                      { time: 0.35, freq: 70, intensity: 0.75, decay: 0.35 },
                      { time: 0.7, freq: 65, intensity: 0.8, decay: 0.4 },
                      { time: 1.0, freq: 60, intensity: 0.85, decay: 0.35 },
                      { time: 1.3, freq: 70, intensity: 0.9, decay: 0.3 },
                      { time: 1.55, freq: 65, intensity: 0.95, decay: 0.35 },
                      { time: 1.8, freq: 60, intensity: 1.0, decay: 0.5 }  // 最强一击
                    ];
                    
                    drumPattern.forEach(({ time, freq, intensity, decay }) => {
                      // 低频鼓声（主体）
                      const kick = ctx.createOscillator();
                      kick.frequency.setValueAtTime(freq * 3, ctx.currentTime + time);
                      kick.frequency.exponentialRampToValueAtTime(freq, ctx.currentTime + time + 0.05);
                      kick.type = 'sine';
                      
                      // 鼓的泛音
                      const overtone = ctx.createOscillator();
                      overtone.frequency.setValueAtTime(freq * 2, ctx.currentTime + time);
                      overtone.type = 'triangle';
                      
                      // 鼓皮噪音
                      const bufferSize = ctx.sampleRate * 0.15;
                      const buffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
                      const data = buffer.getChannelData(0);
                      for (let i = 0; i < bufferSize; i++) {
                        const envelope = Math.exp(-i / (bufferSize * 0.15));
                        data[i] = (Math.random() * 2 - 1) * envelope * 0.5;
                      }
                      const noise = ctx.createBufferSource();
                      noise.buffer = buffer;
                      
                      const noiseFilter = ctx.createBiquadFilter();
                      noiseFilter.type = 'lowpass';
                      noiseFilter.frequency.value = 300;
                      
                      const drumGain = ctx.createGain();
                      drumGain.gain.setValueAtTime(intensity, ctx.currentTime + time);
                      drumGain.gain.exponentialRampToValueAtTime(0.01, ctx.currentTime + time + decay);
                      
                      kick.connect(drumGain);
                      overtone.connect(drumGain);
                      noise.connect(noiseFilter);
                      noiseFilter.connect(drumGain);
                      drumGain.connect(masterGain);
                      
                      kick.start(ctx.currentTime + time);
                      kick.stop(ctx.currentTime + time + decay);
                      overtone.start(ctx.currentTime + time);
                      overtone.stop(ctx.currentTime + time + decay * 0.5);
                      noise.start(ctx.currentTime + time);
                    });
                    
